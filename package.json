{
  "name": "neuro-e-mail-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Agente de e-mail (Google Apps Script) para triagem automatica da caixa de entrada.",
  "scripts": {
    "login": "clasp login",
    "clone": "clasp clone",
    "pull": "clasp pull",
    "push": "clasp push",
